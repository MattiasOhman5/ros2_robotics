<?xml version="1.0"?>
<robot name="turtlebot3_with_trailer" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Include TurtleBot3 base -->
  <xacro:include filename="$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro"/>
  <xacro:turtlebot3_burger/>

  <!-- Trailer link -->
  <link name="trailer_link">
    <visual>
      <geometry>
        <box size="0.3 0.2 0.1"/> <!-- length, width, height -->
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.2 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- Hitch joint -->
  <joint name="hitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="trailer_link"/>
    <origin xyz="-0.15 0 0"/> <!-- behind robot -->
    <axis xyz="0 0 1"/> <!-- rotation around z-axis -->
    <limit effort="10" velocity="1.0" lower="-1.57" upper="1.57"/>
  </joint>

</robot>

